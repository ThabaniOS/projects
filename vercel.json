{
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/*.mjs": { "maxDuration": 60, "includeFiles": "schema/**" }
  },
  "git": {
    "deploymentEnabled": { "bot-state": false }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)inbox' ':(exclude)projects'"
}
