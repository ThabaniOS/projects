{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThabaniOS/projects/schema/project.schema.json",
  "title": "ThabaniOS project frontmatter",
  "type": "object",
  "required": ["id", "name", "ticker", "status", "category", "priority", "finish_line", "updated"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "ticker": { "type": "string", "pattern": "^[A-Z]{2,4}$" },
    "status": { "type": "string", "enum": ["active", "pipeline", "live", "paused"] },
    "category": { "type": "string", "enum": ["raiis", "mb-digital", "client-direct", "venture", "personal"] },
    "client": { "type": "string" },
    "priority": { "type": "integer", "enum": [1, 2, 3] },
    "finish_line": { "type": "string" },
    "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
